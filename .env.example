# Salin berkas ini menjadi .env.local lalu sesuaikan nilainya.
# Tanpa kedua variabel di bawah, aplikasi berjalan dalam mode bebas:
# seluruh route /api/* terbuka tanpa pemeriksaan kunci.

# Daftar API key valid, dipisah koma.
# Buat key baru dengan: node scripts/generate-api-key.mjs --prefix naze
API_KEYS=

# Isi true untuk mengaktifkan mode terproteksi API key.
# Selain true (termasuk kosong), API berjalan dalam mode bebas.
REQUIRE_API_KEY=
